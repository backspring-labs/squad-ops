# The merge sweep's poll (#2862): detection is by polling, so a merge reaches its Project within
# this interval. Persistent, so a window the box was down for runs at the next boot.
[Unit]
Description=SquadOps merge sweep, every 15 minutes

[Timer]
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
