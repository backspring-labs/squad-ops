# TEMPLATE — __USER__ and __REPO_ROOT__ are substituted by scripts/dev/ops/install_host_unit.sh.
#
# The merge sweep (#2862): a contribution merged upstream syncs its Project and re-validates it.
# Runs as the deploy's user, so it reads the forge with that user's GitHub CLI login (reads only:
# every forge call is a GET) and signs in to the runtime under its own CLI config home. It stores
# no token anywhere. Installed deliberately, like the backup timer: it needs sudo.
[Unit]
Description=SquadOps merge sweep (a merged contribution syncs its Project)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__REPO_ROOT__
ExecStart=__REPO_ROOT__/.venv/bin/python __REPO_ROOT__/scripts/dev/ops/merge_sweep.py
Nice=10
