    {
      "id": 5,
      "type": "timeseries",
      "title": "Board thermal zones (ACPI)",
      "description": "TSOC is the system-on-chip, TS0E/TS0P/TS1E/TS1P the core clusters, TGPU the ACPI GPU sensor (it reads hotter than DCGM's die temperature) and TUNC the uncore. Amber line: 98 °C, where the alert fires after 5 minutes. Red line: 104 °C, the critical trip point, a hard power-off. Under a 9.4-hour cycle TSOC and TGPU peaked at 94.9 °C.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            },
            "axisSoftMax": 106
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 98
              },
              {
                "color": "red",
                "value": 104
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A",
          "expr": "label_replace(node_thermal_zone_temp{type=\"acpitz\", zone=\"0\"}, \"zone_name\", \"TSOC\", \"\", \"\")\nor label_replace(node_thermal_zone_temp{type=\"acpitz\", zone=\"1\"}, \"zone_name\", \"TS0E\", \"\", \"\")\nor label_replace(node_thermal_zone_temp{type=\"acpitz\", zone=\"2\"}, \"zone_name\", \"TS0P\", \"\", \"\")\nor label_replace(node_thermal_zone_temp{type=\"acpitz\", zone=\"3\"}, \"zone_name\", \"TS1E\", \"\", \"\")\nor label_replace(node_thermal_zone_temp{type=\"acpitz\", zone=\"4\"}, \"zone_name\", \"TS1P\", \"\", \"\")\nor label_replace(node_thermal_zone_temp{type=\"acpitz\", zone=\"5\"}, \"zone_name\", \"TGPU\", \"\", \"\")\nor label_replace(node_thermal_zone_temp{type=\"acpitz\", zone=\"6\"}, \"zone_name\", \"TUNC\", \"\", \"\")\nor on(zone) node_thermal_zone_temp{type=\"acpitz\"}",
          "legendFormat": "{{zone_name}} (zone {{zone}})",
          "range": true
        }
      ]
    },
