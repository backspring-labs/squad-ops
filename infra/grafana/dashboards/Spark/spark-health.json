{
  "uid": "spark-health",
  "title": "Spark health",
  "tags": [
    "spark",
    "squadops"
  ],
  "description": "The Spark's GPU, board thermals, CPU load, memory and disk (node-exporter and DCGM).",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hottest board zone",
      "description": "The hottest of the seven ACPI zones. Every zone's only trip point is critical at 104 °C, a hard power-off; the alert fires above 98 °C for 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 98
              },
              {
                "color": "red",
                "value": 104
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A",
          "expr": "max(node_thermal_zone_temp{type=\"acpitz\"})",
          "legendFormat": "__auto",
          "instant": true
        }
      ]
    },
