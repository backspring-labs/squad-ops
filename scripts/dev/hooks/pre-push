#!/usr/bin/env bash
# Refuse a push that adds a held-out scenario step value (scripts/dev/heldout_text_scan.py).
#
# Opt-in, and only where the suite is: it runs when SQUADOPS_HELDOUT_SUITES names the suites
# (colon-separated paths, outside every repository), and does nothing otherwise. Install it in a
# checkout that holds the suite:
#
#   ln -s ../../scripts/dev/hooks/pre-push .git/hooks/pre-push
#
# Git hands the hook one line per ref: <local ref> <local sha> <remote ref> <remote sha>. A new
# branch (the remote sha all zeros), or one rebased since its last push (the remote sha isn't an
# ancestor of the local one), is scanned for what it adds where it leaves origin/main. A rebased
# branch's old..new range is main's own history since the old base, which a push of the branch
# doesn't add and can't answer for. A fast-forward is scanned for what it adds since the last push.
set -euo pipefail

[ -n "${SQUADOPS_HELDOUT_SUITES:-}" ] || exit 0

root="$(git rev-parse --show-toplevel)"
python="${SQUADOPS_PYTHON:-$root/.venv/bin/python}"
# The main worktree is listed first. awk reads the whole listing: one that stopped at the first
# line left git writing into a closed pipe, and under pipefail its SIGPIPE ended the hook (#2800).
[ -x "$python" ] || python="$(git -C "$root" worktree list --porcelain | awk '/^worktree / && !f {print $2; f=1}')/.venv/bin/python"

suites=()
IFS=':' read -r -a paths <<< "$SQUADOPS_HELDOUT_SUITES"
for p in "${paths[@]}"; do suites+=(--suite "$p"); done

zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # a deletion adds nothing
  if [ "$remote_sha" = "$zero" ] || ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    range="origin/main...$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if ! "$python" "$root/scripts/dev/heldout_text_scan.py" "${suites[@]}" --range "$range" >/dev/null; then
    echo "pre-push: $local_ref adds a held-out step value, or the scan couldn't run." >&2
    echo "  Rerun: $python scripts/dev/heldout_text_scan.py ${suites[*]} --range $range" >&2
    status=1
  fi
done
exit $status
