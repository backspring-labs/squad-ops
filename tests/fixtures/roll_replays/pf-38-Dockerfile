# ---------------------------------------------------------------------------
# Stage 1: Build frontend static assets (Node)
# ---------------------------------------------------------------------------
FROM node:20-alpine AS frontend-build

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/ ./
# VITE_API_BASE: optional prefix for the frontend API client.
# Leave empty (default) so the client uses relative /api/* paths that the
# bundled nginx will proxy to the backend.
ARG VITE_API_BASE=
ENV VITE_API_BASE=${VITE_API_BASE}
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: Install Python backend dependencies
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS backend-deps

WORKDIR /app
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# ---------------------------------------------------------------------------
# Stage 3: Final image — nginx serves frontend, uvicorn serves backend
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS final

RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --- Backend runtime deps ---
COPY --from=backend-deps /usr/local/lib/python3.11/dist-packages /usr/local/lib/python3.11/dist-packages
COPY --from=backend-deps /usr/local/bin /usr/local/bin

# --- Source ---
COPY backend/ ./backend/

# --- Frontend built assets ---
COPY --from=frontend-build /build/dist /var/www/html

# --- Nginx config ---
COPY nginx.conf /etc/nginx/conf.d/default.conf

# --- Entrypoint ---
COPY start.sh /start.sh
RUN chmod +x /start.sh

# CORS_ORIGINS is read at container start by the FastAPI middleware.
# Pass at runtime so the same image works across environments.
ENV CORS_ORIGINS=*

EXPOSE 80

ENTRYPOINT ["/start.sh"]