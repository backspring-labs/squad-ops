# SquadOps Environment Variable Overrides
# Copy this file to .env and modify as needed
# Environment variables use SQUADOPS__ prefix with double underscores for nesting
# Example: SQUADOPS__DB__POOL__SIZE=10 maps to db.pool.size

# Compose: all services are in the single docker-compose.yml
COMPOSE_FILE=docker-compose.yml

# Keycloak realm name (used by docker-compose, console, CLI)
SQUADOPS_REALM=squadops-dev  # Bootstrap sets this — squadops-dev, squadops-local, etc.
# SQUADOPS_HOST=localhost  # Set to hostname/IP if accessing from another machine (e.g. spark.local)

# =============================================================================
# The deploy's own credentials (#2006)
# =============================================================================
# Leave these empty: bootstrap and rebuild_and_deploy.sh run
# scripts/dev/ops/deploy_credentials.py ensure, which generates each one into .env and
# derives secrets/ from it (infra/deploy_credentials.json names them all). Compose refuses
# to resolve without them. `squadops doctor` refuses a value the repository has committed.
# Rotating one on a running deploy: docs/ops/credential_rotation.md.

POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# The integration-test role's password (#1180). `squadops_test` owns the `squadops_test`
# database and is refused by the deployment database at the server (REVOKE CONNECT ...
# FROM PUBLIC). Bootstrap and rebuild_and_deploy.sh provision the role from .env's value.
# `squadops doctor` verifies the refusal.
POSTGRES_TEST_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
SQUADOPS_AGENT_CLIENT_SECRET=
SQUADOPS_RUNTIME_CLIENT_SECRET=
LANGFUSE_DB_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
SQUADOPS_SANDBOX_SERVICE_TOKEN=
# TensorFold's key (SIP-0111): the server reads secrets/tensorfold_api_key.txt, written from it, and
# docker-compose.tensorfold.yml hands it to every model client when the switch moves them there.
SQUADOPS_TENSORFOLD_API_KEY=

# =============================================================================

# Profile Selection
SQUADOPS_PROFILE=dev  # Options: dev, local, lab, cloud

# Strict Configuration Mode
# SQUADOPS_STRICT_CONFIG=true  # Enable strict validation (errors on unknown keys)

# Database Configuration
# SQUADOPS__DB__URL=postgresql://user:password@host:5432/dbname
# SQUADOPS__DB__POOL__SIZE=10
# SQUADOPS__DB__MAX__OVERFLOW=20
# SQUADOPS__DB__RETRY__ATTEMPTS=3          # tries for a transient database failure (#1976)
# SQUADOPS__DB__RETRY__BACKOFF_SECONDS=0.05 # the first pause between tries; it doubles

# RabbitMQ Configuration
# SQUADOPS__COMMS__RABBITMQ__URL=amqp://user:password@host:5672/vhost
# SQUADOPS__COMMS__RABBITMQ__HOST=rabbitmq
# SQUADOPS__COMMS__RABBITMQ__PORT=5672
# SQUADOPS__COMMS__RABBITMQ__USER=squadops

# Redis Configuration
# SQUADOPS__COMMS__REDIS__URL=redis://host:6379/0
# SQUADOPS__COMMS__REDIS__HOST=redis
# SQUADOPS__COMMS__REDIS__PORT=6379

# Runtime API
# SQUADOPS__RUNTIME__API__URL=http://runtime-api:8001

# Duty-transition scheduler (SIP-0089 §2.4) — opt-in. When enabled, the
# runtime-api process runs an in-process scheduler that opens/closes duty
# windows by writing agent mode (ambient<->duty). Run exactly one runtime-api
# instance with this enabled (single central mode-writer; no leader election).
# SQUADOPS__RUNTIME__SCHEDULER__ENABLED=false
# SQUADOPS__RUNTIME__SCHEDULER__POLL_INTERVAL_SECONDS=30

# Prefect Configuration
# SQUADOPS__PREFECT__API__URL=http://prefect-server:4200/api

# LLM Configuration
# The provider is REQUIRED — it selects the adapter (ollama | vllm | atlas | tensorfold) and nothing defaults
# it (#1157). docker-compose.yml sets it per service; set it here for host-side runs.
SQUADOPS__LLM__PROVIDER=ollama
# #1568: every provider selector is required and never defaulted. These two (and the project
# registry's, below) are interpolated by
# docker-compose.yml from this file (the others are set per service there); set the rest here
# for host-side runs.
SQUADOPS__PROMPTS__ASSET_SOURCE_PROVIDER=filesystem
SQUADOPS__SANDBOX__PROVIDER=noop
# #2451 (the owner's ruling, 2026-10-18): the runtime API's client of the sandbox service, apart
# from SQUADOPS__SANDBOX__PROVIDER above, which the runtime's cycle-create preflight still reads.
# `http` calls the service (URL and token come from docker-compose.yml); `none` calls nothing.
SQUADOPS__SANDBOX_CLIENT__PROVIDER=http
# The sandbox service's OWN provider (#2451): `docker` runs execution units and SIP-0113's
# scenario runner; `noop` runs nothing. The service starts with `rebuild_and_deploy.sh sandbox`.
SQUADOPS_SANDBOX_SERVICE_PROVIDER=docker
SQUADOPS__CYCLES__REGISTRY_PROVIDER=postgres
SQUADOPS__CYCLES__SQUAD_PROFILE_PROVIDER=postgres
# SIP-0112 FR-03 (#2408): which Project registry is authoritative. `config` reads
# config/projects.yaml, the only authority before the cutover; `postgres` is the writable
# registry after it; `postgres_read_only` is that registry with registration gated off, the
# rollback (every Project stays readable). Interpolated by docker-compose.yml, per deploy.
SQUADOPS__CYCLES__PROJECT_REGISTRY_PROVIDER=postgres
SQUADOPS__AUTH__PROVIDER=keycloak
SQUADOPS__COMMS__QUEUE__PROVIDER=rabbitmq
SQUADOPS__COMMS__A2A__PROVIDER=http
SQUADOPS__TOOLS__FILESYSTEM__PROVIDER=local
# Where every LLM client reaches Ollama: required, never defaulted (#2249). A host Ollama (the
# Mac's, the PC's) is reached through the Docker host gateway; the Spark's runs in a container
# (docker-compose.ollama.yml) and its .env says http://ollama:11434.
SQUADOPS__LLM__URL=http://host.docker.internal:11434
# Atlas (provider=atlas, port 8888) requires a bearer token once bound off localhost; give
# it as a secret:// reference resolved by the configured secrets provider (SIP-0106 §3.5).
# SQUADOPS__LLM__API_KEY=secret://atlas_api_key
# SQUADOPS__LLM__MODEL=llama3.1:8b
# SQUADOPS__LLM__TIMEOUT=60
# How long the orchestrator waits for a dispatched task before calling the agent hung
# (#1147). A different quantity from the LLM request timeout above — a task is several
# model calls plus file I/O and a test run. REQUIRED: docker-compose.yml refuses to start
# the runtime API without it, and it never follows SQUADOPS__LLM__TIMEOUT (1.8.2 item 15).
# 1800 s is what every deploy through 1.8.1 ran with, by inheritance.
SQUADOPS__DISPATCH__TASK_TIMEOUT=1800

# Agent Configuration
# SQUADOPS__AGENT__ID=my_agent
# SQUADOPS__AGENT__ROLE=lead
# SQUADOPS__AGENT__DISPLAY__NAME=My Agent

# Cycle Data Configuration
# SQUADOPS__CYCLE__DATA__ROOT=/path/to/cycle_data

# Telemetry Configuration
# Required by the agents (#1449): otel | console | null — docker-compose.yml sets it per agent.
SQUADOPS__TELEMETRY__BACKEND=otel
# Required with the otel backend: the runtime and the agents export their metrics here (#2204).
SQUADOPS__TELEMETRY__OTLP_ENDPOINT=http://localhost:4317
# SQUADOPS__TELEMETRY__PROMETHEUS_PORT=8888

# Cycle Verification (SIP-0096)
# SQUADOPS__CYCLES__INERT_CYCLE_THRESHOLD=3   # §9 N: consecutive not-executed cycles before a check is inert

# Agent Lifecycle Configuration
# SQUADOPS__AGENT__INSTANCES_FILE=agents/instances/instances.yaml
# SQUADOPS__AGENT__HEARTBEAT_TIMEOUT_WINDOW=90
# SQUADOPS__AGENT__RECONCILIATION_INTERVAL=45

# LangFuse LLM Observability (SIP-0061)
# These two must be uncommented (even if blank) to suppress Docker Compose warnings.
SQUADOPS__LANGFUSE__PUBLIC_KEY=
SQUADOPS__LANGFUSE__SECRET_KEY=
# SQUADOPS__LANGFUSE__ENABLED=false
# SQUADOPS__LANGFUSE__HOST=http://localhost:3001
# SQUADOPS__LANGFUSE__REDACTION_MODE=standard   # use "strict" in production
# SQUADOPS__LANGFUSE__SAMPLE_RATE_PERCENT=100
# SQUADOPS__LANGFUSE__FLUSH_INTERVAL_SECONDS=5
# SQUADOPS__LANGFUSE__BUFFER_MAX_SIZE=1000
# SQUADOPS__LANGFUSE__SHUTDOWN_FLUSH_TIMEOUT_SECONDS=5

# The Spark's Ollama container (#2249), written by the local-spark bootstrap; unset elsewhere.
# COMPOSE_FILE=docker-compose.yml:docker-compose.ollama.yml
# COMPOSE_PROFILES=gpu
# SQUADOPS_OLLAMA_HOME=/usr/share/ollama
# SQUADOPS_OLLAMA_UID=
# SQUADOPS_OLLAMA_GID=
